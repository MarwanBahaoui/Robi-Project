      <Item class="ModuleScript" referent="RBX12592">
        <Properties>
          <string name="Name">Driving</string>
          <ProtectedString name="Source">local D={}
D.Settings={brake=65,coast=8,reverseRatio=.32,steerResponse=9,wheelbase=7,lowAngle=30,highAngle=15,handbrake=38}
local function approach(a,b,amount) return a+math.clamp(b-a,-amount,amount) end
function D.Step(r,d,dt,upgrade)
 local h=D.Settings
 local old=r.speed
 local t=r.throttle or 0
 local braking=t*r.speed &lt; -.5 or r.handbrake
 if r.handbrake then r.speed=approach(r.speed,0,h.handbrake*dt)
 elseif math.abs(t)&lt;.05 then r.speed=approach(r.speed,0,h.coast*dt)
 elseif t*r.speed&lt;-.5 then
  r.speed=approach(r.speed,0,h.brake*dt)
 else
  local goal=t*(t&lt;0 and d.speed*h.reverseRatio or d.speed)
  local engine=d.accel*(upgrade==1 and 1.3 or 1)*(1-.28*math.min(1,math.abs(r.speed)/d.speed))
  r.speed=approach(r.speed,goal,engine*dt)
 end
 r.steering=(r.steering or 0)+((r.steer or 0)-(r.steering or 0))*(1-math.exp(-h.steerResponse*dt))
 local ratio=math.clamp(math.abs(r.speed)/d.speed,0,1)
 local angle=math.rad(h.lowAngle+(h.highAngle-h.lowAngle)*ratio)*r.steering
 if r.handbrake then angle*=1.3 end
 local yawRate=-r.speed/h.wheelbase*math.tan(angle)
 r.yaw=math.atan2(math.sin(r.yaw+yawRate*dt),math.cos(r.yaw+yawRate*dt))
 local nextPos=r.pos+Vector3.new(math.cos(r.yaw),0,-math.sin(r.yaw))*r.speed*dt
 -- Open the garage approach after the safe line; keep vans inside the perimeter.
 local garageArea=r.escaped or nextPos.X&gt;=65
 local z=math.clamp(nextPos.Z,garageArea and -294 or -48,garageArea and 294 or 48)
 local x=math.clamp(nextPos.X,garageArea and 65 or -130,garageArea and 299 or 70)
 if z~=nextPos.Z or x~=nextPos.X then r.speed*=.35;r.impact=1 end
 r.pos=Vector3.new(x,3.4,z)
 r.impact=math.max(0,(r.impact or 0)-dt*4)
 r.wheel=(r.wheel or 0)+r.speed*dt/1.25
 r.acceleration=(r.speed-old)/math.max(dt,.001)
 r.braking=braking
 r.turnAngle=angle
 r.yawRate=yawRate
 return r
end
function D.Frame(r)
 local speed=math.abs(r.speed)
 local lean=math.clamp(-(r.yawRate or 0)*speed*.0014,-.055,.055)
 local pitch=math.clamp((r.acceleration or 0)*.0008,-.035,.035)
 local bob=math.sin((r.wheel or 0)*.65)*.025*math.min(speed/20,1)
 return CFrame.new(r.pos+Vector3.new(0,bob,0))*CFrame.Angles(0,r.yaw,0)*CFrame.Angles(lean,0,pitch)
end
return D
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12596">
        <Properties>
          <string name="Name">Parking</string>
          <ProtectedString name="Source">local P={}
P.MaxSpeed=1.2
P.HoldTime=.3
P.AngleTolerance=math.rad(30)
function P.Check(position,yaw,speed,padPosition,padSize)
 local x=math.abs(position.X-padPosition.X);local z=math.abs(position.Z-padPosition.Z)
 -- Forgiving center zone: a straight van still fits completely inside the larger bay.
 local allowanceX=math.max(.5,padSize.X/2-5.15)
 local allowanceZ=math.max(.5,padSize.Z/2-2.9)
 if x&gt;allowanceX or z&gt;allowanceZ then return false,"Move into the middle of your highlighted bay" end
 local angle=math.acos(math.clamp(math.abs(math.cos(yaw)),-1,1))
 if angle&gt;P.AngleTolerance then return false,"Turn roughly along the parking lines" end
 if math.abs(speed)&gt;P.MaxSpeed then return false,"Brake and stop - Space makes parking easier" end
 return true,"Good position - hold still"
end
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12600">
        <Properties>
          <string name="Name">Tutorial</string>
          <ProtectedString name="Source">local T={}
function T.Resolve(context,data)
 local found=0
 for _,v in ipairs(data.discoveries or {}) do if v.found then found+=1 end end
 if context.enabled==nil then context.enabled=found==0 end
 if not context.enabled or context.done then return nil end
 if context.traderVisited then context.done=true;return nil end
 if data.driving then
  if context.escaped then
   return {step=2,title="PARK IN YOUR GARAGE",text="Follow the arrow. Stop inside the amber bay. When it turns green, press E or Exit Van.",target="parking"}
  end
  return {step=2,title="ESCAPE TO THE GREEN LINE",text="Accelerate toward the green line. The guard gives up when you cross it.",target="safe"}
 end
 if found==0 then
  return {step=1,title="STEAL YOUR FIRST VAN",text="Walk to the highlighted Rusty van and press E, or tap Steal. The guard reacts after you steal.",target="van"}
 end
 if context.collected or data.arrival or (data.rate or 0)==0 then
  return {step=4,title="MEET YOUR GARAGE TRADER",text="Visit the highlighted trader to see selling and upgrades. You do not need to buy anything.",target="trader"}
 end
 return {step=3,title="COLLECT YOUR EARNINGS",text="Your parked van earns $"..tostring(data.rate or 0).."/second. Use the green cash collector to collect it.",target="cash"}
end
return T

</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX12604">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX12607">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX12610">
        <Properties>
          <string name="Name">RideClient</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local Run=game:GetService("RunService")
local p=Players.LocalPlayer
local net=game.ReplicatedStorage:WaitForChild("RideNetwork")
local action=net:WaitForChild("Action")
local gui=Instance.new("ScreenGui");gui.Name="RideHUD";gui.ResetOnSpawn=false;gui.IgnoreGuiInset=false;gui.Parent=p:WaitForChild("PlayerGui")
local function round(x)local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,9);c.Parent=x end
local function frame(name,size,pos,parent)
    local f=Instance.new("Frame");f.Name=name;f.Size=size;f.Position=pos;f.BackgroundColor3=Color3.fromRGB(21,35,47);f.BackgroundTransparency=.08;f.Parent=parent or gui;round(f);return f
end
local function label(parent,name,text,size,height)
    local t=Instance.new("TextLabel");t.Name=name;t.Size=UDim2.new(1,-16,0,height);t.BackgroundTransparency=1;t.Text=text;t.TextColor3=Color3.fromRGB(239,244,240)
    t.TextSize=size;t.TextWrapped=true;t.Font=Enum.Font.Gotham;t.TextXAlignment=Enum.TextXAlignment.Left;t.Parent=parent;return t
end
local panel=frame("Overview",UDim2.new(.70,0,0,144),UDim2.fromOffset(12,12))
local limit=Instance.new("UISizeConstraint");limit.MaxSize=Vector2.new(430,144);limit.Parent=panel
local money=label(panel,"Money","Loading garage...",17,25);money.Position=UDim2.fromOffset(10,7)
local collection=label(panel,"Collection","3-van test collection",14,22);collection.Position=UDim2.fromOffset(10,35)
local status=label(panel,"Status","Approach a van and press Steal",15,76);status.Position=UDim2.fromOffset(10,61);status.TextColor3=Color3.fromRGB(255,221,127)
local hint=frame("Controls",UDim2.new(.94,0,0,38),UDim2.new(.03,0,1,-48))
local hintText=label(hint,"Text","W accelerate • S brake / reverse • A/D steer • Space handbrake",14,36);hintText.Position=UDim2.fromOffset(8,0)
local modal=frame("Trader",UDim2.new(.9,0,.68,0),UDim2.fromScale(.05,.22));modal.Visible=false
local max=Instance.new("UISizeConstraint");max.MaxSize=Vector2.new(560,470);max.Parent=modal
modal.AnchorPoint=Vector2.new(.5,.5);modal.Position=UDim2.fromScale(.5,.56)
local title=label(modal,"Title","GARAGE TRADER",21,32);title.Position=UDim2.fromOffset(12,8)
local list=Instance.new("ScrollingFrame");list.Name="List";list.Position=UDim2.fromOffset(12,94);list.Size=UDim2.new(1,-24,1,-150);list.BackgroundTransparency=1;list.BorderSizePixel=0
list.AutomaticCanvasSize=Enum.AutomaticSize.Y;list.CanvasSize=UDim2.new();list.ScrollBarThickness=5;list.Parent=modal
local layout=Instance.new("UIListLayout");layout.Padding=UDim.new(0,7);layout.Parent=list
local saveLabel=label(gui,"SaveStatus","Loading progress...",13,22)
saveLabel.Position=UDim2.fromOffset(22,160);saveLabel.Size=UDim2.fromOffset(300,22)
saveLabel.TextColor3=Color3.fromRGB(186,224,209)
local function refreshSave() saveLabel.Text=p:GetAttribute("SaveState") or "Loading progress..." end
p:GetAttributeChangedSignal("SaveState"):Connect(refreshSave)
refreshSave()
local Tutorial=require(net:WaitForChild("Tutorial"))
local tutorialContext={}
local tutorialCard=frame("FirstRideGuide",UDim2.new(.70,0,0,115),UDim2.fromOffset(12,198))
tutorialCard.Visible=false
local tutorialLimit=Instance.new("UISizeConstraint");tutorialLimit.MaxSize=Vector2.new(430,115);tutorialLimit.Parent=tutorialCard
local tutorialTitle=label(tutorialCard,"Title","",15,27);tutorialTitle.Position=UDim2.fromOffset(12,8);tutorialTitle.Font=Enum.Font.GothamBold;tutorialTitle.TextColor3=Color3.fromRGB(117,255,194)
local tutorialText=label(tutorialCard,"Instruction","",14,68);tutorialText.Position=UDim2.fromOffset(12,36)
local skip=Instance.new("TextButton");skip.Name="Skip";skip.Size=UDim2.fromOffset(42,24);skip.Position=UDim2.new(1,-48,0,8);skip.Text="Skip";skip.TextSize=12;skip.BackgroundTransparency=1;skip.TextColor3=Color3.fromRGB(215,223,225);skip.Parent=tutorialCard
tutorialTitle.Size=UDim2.new(1,-66,0,27)
local guideGlow=Instance.new("Highlight");guideGlow.Name="FirstRideTarget";guideGlow.FillColor=Color3.fromRGB(106,255,183);guideGlow.FillTransparency=.72;guideGlow.OutlineColor=Color3.fromRGB(185,255,217);guideGlow.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;guideGlow.Enabled=false;guideGlow.Parent=gui
local sprintBadge=frame("ReturnSprint",UDim2.fromOffset(265,38),UDim2.new(.5,-132,1,-195))
sprintBadge.Visible=false
