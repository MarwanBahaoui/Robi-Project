  <Item class="ServerScriptService" referent="RBX12535">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX12538">
      <Properties>
        <string name="Name">RidePrototype</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX12541">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">return {
    Vans = {
        {id="Rusty", label="Rusty Runner", income=2, sale=60, speed=40, accel=28, reaction=2.5, guardSpeed=24, color=Color3.fromRGB(177,102,65)},
        {id="Armored", label="Armored Hauler", income=5, sale=150, speed=33, accel=15, reaction=2.2, guardSpeed=27, color=Color3.fromRGB(80,101,117)},
        {id="Sport", label="Sport Courier", income=9, sale=270, speed=53, accel=36, reaction=1.6, guardSpeed=34, color=Color3.fromRGB(230,173,49)},
    },
    Lanes={-32,0,32}, StartX=-110, SafeX=65, GarageX=88,
    ReturnSprintSpeed=32,
    MaxPlayers=4, AccelerationCost=90, SlotCost=180,
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12545">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local C=require(script.Parent.Config)
local W={}
local function part(parent,name,size,cf,color,material)
    local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Anchored=true
    p.Color=color;p.Material=material or Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
    return p
end
local function sign(parent,adornee,text,color,offset)
    local g=Instance.new("BillboardGui");g.Name="Label";g.Adornee=adornee;g.Size=UDim2.fromOffset(260,64)
    g.StudsOffset=offset or Vector3.new(0,5,0);g.MaxDistance=105;g.Parent=parent
    local t=Instance.new("TextLabel");t.Name="Text";t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1
    t.Font=Enum.Font.GothamBold;t.TextSize=17;t.TextWrapped=true;t.TextColor3=color or Color3.new(1,1,1);t.TextStrokeTransparency=.35;t.Text=text;t.Parent=g
    return t
end
local function prompt(parent,name,action,object)
    local p=Instance.new("ProximityPrompt");p.Name=name;p.ActionText=action;p.ObjectText=object
    p.HoldDuration=0;p.MaxActivationDistance=13;p.RequiresLineOfSight=false;p.Parent=parent
    return p
end
function W.Van(parent,def,cf,name)
    local m=Instance.new("Model");m.Name=name or def.id;m:SetAttribute("VanType",def.id)
    local body=part(m,"Body",Vector3.new(10,3.4,5),cf*CFrame.new(0,2.8,0),def.color)
    m.PrimaryPart=body
    part(m,"Cabin",Vector3.new(3.3,2.1,4.7),cf*CFrame.new(3,5,0),def.color)
    part(m,"Cargo",Vector3.new(6.5,2.1,4.7),cf*CFrame.new(-1.9,5,0),def.color:Lerp(Color3.new(1,1,1),.10))
    part(m,"Windshield",Vector3.new(.12,1.5,3.9),cf*CFrame.new(4.72,5.1,0),Color3.fromRGB(113,196,211),Enum.Material.Glass)
    for _,z in ipairs({-2.42,2.42}) do
        part(m,"SideWindow",Vector3.new(2.4,1.4,.12),cf*CFrame.new(3,5,z),Color3.fromRGB(113,196,211),Enum.Material.Glass)
        part(m,"Stripe",Vector3.new(9,.25,.12),cf*CFrame.new(0,3.3,z*1.04),Color3.fromRGB(237,226,198))
        for _,x in ipairs({-3.1,3.1}) do
            local tire=part(m,"Wheel",Vector3.new(.8,2.5,2.5),cf*CFrame.new(x,1.4,z)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(26,31,39))
            tire.Shape=Enum.PartType.Cylinder
        end
    end
    for _,z in ipairs({-1.7,1.7}) do part(m,"Headlight",Vector3.new(.15,.7,.9),cf*CFrame.new(5.1,3,z),Color3.fromRGB(255,244,195),Enum.Material.Neon) end
    m:SetAttribute("OriginToBody",2.8)
    m.Parent=parent
    return m
end
function W.Guard(parent,cf,name)
    local m=Instance.new("Model");m.Name=name
    local torso=part(m,"Torso",Vector3.new(2,2.2,1.2),cf*CFrame.new(0,3.1,0),Color3.fromRGB(32,58,88));m.PrimaryPart=torso
    local head=part(m,"Head",Vector3.new(1.5,1.5,1.5),cf*CFrame.new(0,5,0),Color3.fromRGB(224,183,138))
    part(m,"Cap",Vector3.new(1.9,.35,1.8),cf*CFrame.new(0,5.9,0),Color3.fromRGB(24,43,66))
    part(m,"Badge",Vector3.new(.4,.5,.1),cf*CFrame.new(-.45,3.45,-.66),Color3.fromRGB(255,203,64),Enum.Material.Metal)
    for _,x in ipairs({-.55,.55}) do part(m,"Leg",Vector3.new(.85,2,1),cf*CFrame.new(x,1,0),Color3.fromRGB(27,35,48)) end
    for _,x in ipairs({-1.4,1.4}) do part(m,"Arm",Vector3.new(.7,2,1),cf*CFrame.new(x,3.1,0),Color3.fromRGB(32,58,88)) end
    local lens=part(m,"Flashlight",Vector3.new(.45,.45,1.4),cf*CFrame.new(1.4,2.5,-1),Color3.fromRGB(31,35,41))
    local light=Instance.new("SpotLight");light.Face=Enum.NormalId.Front;light.Range=26;light.Angle=46;light.Brightness=2;light.Shadows=true;light.Color=Color3.fromRGB(255,239,190);light.Parent=lens
    part(m,"Lens",Vector3.new(.4,.4,.06),lens.CFrame*CFrame.new(0,0,-.72),Color3.fromRGB(255,239,190),Enum.Material.Neon)
    for _,p in ipairs(m:GetChildren()) do if p:IsA("BasePart") then p.CanCollide=false;p.CanTouch=false end end
    sign(m,head,"SECURITY",Color3.fromRGB(255,216,112),Vector3.new(0,2,0))
    m.Parent=parent;return m
end
function W.Build()
    if workspace:FindFirstChild("RidePrototype") then
        require(script.Parent.Scenery).Apply(workspace.RidePrototype)
        require(script.Parent.GaragePlots).Apply(workspace.RidePrototype)
        return workspace.RidePrototype
    end
    local world=Instance.new("Folder");world.Name="RidePrototype"
    local targets=Instance.new("Folder");targets.Name="Targets";targets.Parent=world
    local guards=Instance.new("Folder");guards.Name="Guards";guards.Parent=world
    local garages=Instance.new("Folder");garages.Name="Garages";garages.Parent=world
    part(world,"Road",Vector3.new(240,1,108),CFrame.new(-20,0,0),Color3.fromRGB(47,59,69),Enum.Material.Asphalt)
    for _,z in ipairs({-54,54}) do part(world,"Curb",Vector3.new(240,1,1),CFrame.new(-20,.6,z),Color3.fromRGB(189,203,204)) end
    for _,z in ipairs(C.Lanes) do for x=-90,50,20 do part(world,"RoadMark",Vector3.new(7,.08,.65),CFrame.new(x,.55,z),Color3.fromRGB(236,206,101)) end end
    for i,def in ipairs(C.Vans) do
        local z=C.Lanes[i]
        part(world,"TargetPad",Vector3.new(18,.2,16),CFrame.new(C.StartX,.65,z),def.color:Lerp(Color3.new(),.25))
        local van=W.Van(targets,def,CFrame.new(C.StartX,.6,z),def.id)
        prompt(van.Body,"Steal","Steal",def.label.." | $"..def.income.."/s")
        sign(van,van.Body,def.label.."\n$"..def.income.."/s  •  Sell $"..def.sale,Color3.fromRGB(255,230,150))
        W.Guard(guards,CFrame.new(C.StartX-7,.6,z+10),def.id)
    end
    part(world,"SafeLine",Vector3.new(1,.12,108),CFrame.new(C.SafeX,.65,0),Color3.fromRGB(93,236,172),Enum.Material.Neon)
    local safe=part(world,"SafeSign",Vector3.new(.1,.1,.1),CFrame.new(C.SafeX,1,0),Color3.fromRGB(93,236,172));safe.Transparency=1;safe.CanCollide=false
    sign(world,safe,"GARAGES →\nCross the green line to escape",Color3.fromRGB(123,255,191),Vector3.new(0,11,0))
    for i=1,C.MaxPlayers do
        local z=(i-1)*48-72
        local garage=Instance.new("Model");garage.Name=tostring(i);garage.Parent=garages
        local floor=part(garage,"Floor",Vector3.new(48,1,42),CFrame.new(100,0,z),Color3.fromRGB(63,88,91));garage.PrimaryPart=floor
        part(garage,"BackWall",Vector3.new(1,10,42),CFrame.new(124,5,z),Color3.fromRGB(38,58,69))
        sign(garage,floor,"AVAILABLE GARAGE",Color3.fromRGB(145,235,213),Vector3.new(0,11,0))
        for slot=1,3 do
            local pad=part(garage,"Slot"..slot,Vector3.new(17,.15,11),CFrame.new(108,.65,z+(slot-2)*11),Color3.fromRGB(95,127,126))
            pad:SetAttribute("Slot",slot)
        end
        part(garage,"Arrival",Vector3.new(17,.15,11),CFrame.new(88,.65,z+11),Color3.fromRGB(174,132,48))
        local cash=part(garage,"Collect",Vector3.new(3,1.2,3),CFrame.new(86,1.2,z-13),Color3.fromRGB(67,186,128));prompt(cash,"Collect","Collect","Garage income")
        local trader=W.Guard(garage,CFrame.new(87,.6,z-3),"Trader")
        trader.Torso.Color=Color3.fromRGB(45,139,128);trader.Label.Text.Text="GARAGE TRADER"
        prompt(trader.Torso,"Trade","Open trader","Sell vans / upgrades")
    end
    local spawn=Instance.new("SpawnLocation");spawn.Name="PrototypeSpawn";spawn.Size=Vector3.new(8,1,8);spawn.CFrame=CFrame.new(-92,1,0)
    spawn.Anchored=true;spawn.Neutral=true;spawn.Duration=0;spawn.Color=Color3.fromRGB(86,180,174);spawn.Parent=world
    local banner=part(world,"Welcome",Vector3.new(.1,.1,.1),CFrame.new(-98,2,0),Color3.new());banner.Transparency=1;banner.CanCollide=false
    sign(world,banner,"STEAL A RIDE\nPick a van • Steal • Escape",Color3.fromRGB(255,235,172),Vector3.new(0,13,0))
    world.Parent=workspace
    require(script.Parent.Scenery).Apply(world)
    require(script.Parent.GaragePlots).Apply(world)
    return world
end
return W
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12549">
        <Properties>
          <string name="Name">Game</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Run=game:GetService("RunService")
local Http=game:GetService("HttpService")
local Prompts=game:GetService("ProximityPromptService")
local C=require(script.Parent.Config)
local W=require(script.Parent.World)
local Driving=require(game.ReplicatedStorage.RideNetwork.Driving)
local Parking=require(game.ReplicatedStorage.RideNetwork.Parking)
local ProfileStore=require(script.Parent.ProfileStore)
local ReturnSprint=require(script.Parent.ReturnSprint)
local Tiers=require(script.Parent.GarageTiers)
local Plots=require(script.Parent.GaragePlots)
local G={}
function G.Start()
    local world=W.Build()
    Plots.Apply(world)
    local network=game.ReplicatedStorage:WaitForChild("RideNetwork")
    local action=network.Action
    local update=network.Update
    local motion=network:WaitForChild("Motion")
    local accounts,active,guards,garageOwners={},{},{},{}
    local function telemetry(p,r,a)
        motion:FireClient(p,r and {kind=r.kind,pos=r.pos,yaw=r.yaw,speed=r.speed,steering=r.steering or 0,wheel=r.wheel or 0,acceleration=r.acceleration or 0,yawRate=r.yawRate or 0,braking=r.braking,impact=r.impact or 0,definition=r.definition,upgrade=a and a.accel,escaped=r.escaped,parkingReady=r.parkingReady,parkingPosition=r.parkingPad and r.parkingPad.Position,garagePosition=a and a.garage.Entrance.Position} or {ended=true})
    end
    local defs={}
    for _,def in ipairs(C.Vans) do defs[def.id]=def end
    local storeName=Run:IsStudio() and "RideProfiles_Studio_v1" or "RideProfiles_Live_v1"
    local store=game:GetService("DataStoreService"):GetDataStore(storeName)
    local profiles=ProfileStore.new(store,game.JobId..":"..Http:GenerateGUID(false),defs)
    local closing=false
    local loading=0
    local savesInFlight=0
    local function snapshot(a)
        local vans={}
        for id,v in pairs(a.vans) do table.insert(vans,{id=id,kind=v.kind,slot=v.slot}) end
        table.sort(vans,function(x,y)return x.id&lt;y.id end)
        local discoveries={};for kind,value in pairs(a.discovered) do discoveries[kind]=value end
        return {schema=2,tier=a.tier,cash=a.cash,bank=a.bank,capacity=a.capacity,accel=a.accel,vans=vans,discovered=discoveries}
    end
    local function save(p,a,release)
        if not a or a.released then return false end
        savesInFlight+=1
        p:SetAttribute("SaveState","Saving...")
        local ok,err=profiles:Save(tostring(p.UserId),snapshot(a),release)
        savesInFlight-=1
        if ok then
            a.lastSave=os.clock();a.dirty=false
            if release then a.released=true end
            p:SetAttribute("SaveState","Progress saved")
        else
            p:SetAttribute("SaveState","Save delayed - retrying")
            warn("Ride save failed for "..p.UserId..": "..tostring(err))
            if not profiles:Owns(tostring(p.UserId)) and p.Parent then
                a.closing=true
                p:Kick("Your save session could not be kept open. Please rejoin to protect your progress.")
            end
        end
        return ok
    end
    local function dirty(a) a.dirty=true end
    for _,def in ipairs(C.Vans) do
        local m=world.Guards[def.id]
        guards[def.id]={model=m,home=m:GetPivot(),mode="idle",time=0}
    end
    local function notice(a,text) a.status=text end
    local function income(a)
        local n=0
        for _,v in pairs(a.vans) do if v.slot&gt;0 then n+=defs[v.kind].income end end
        return n
    end
    local function send(p)
        local a=accounts[p];if not a then return end
        local vans,discoveries={},{}
        for id,v in pairs(a.vans) do table.insert(vans,{id=id,kind=v.kind,slot=v.slot,income=v.slot&gt;0 and defs[v.kind].income or 0,sale=defs[v.kind].sale}) end
        table.sort(vans,function(x,y)return x.id&lt;y.id end)
        for _,d in ipairs(C.Vans) do table.insert(discoveries,{name=d.label,found=a.discovered[d.id]==true}) end
        update:FireClient(p,{cash=a.cash,bank=math.floor(a.bank),rate=income(a),capacity=a.capacity,
            accel=a.accel,arrival=a.arrival,status=a.status,vans=vans,discoveries=discoveries,
            driving=a.run and a.run.kind or false,garage=a.garage.Name,quote=a.quote,
            slotCost=Tiers.SlotCost(a.tier,a.capacity),garageUpgrade=Tiers.Offer(a),accelCost=C.AccelerationCost})
    end
    local function root(p)
        local char=p.Character;local h=char and char:FindFirstChildOfClass("Humanoid")
        return h and h.Health&gt;0 and char:FindFirstChild("HumanoidRootPart"),h
    end
    local function release(p,a)
        local rec=a.rider
        if rec then
            a.rider=nil
            p:SetAttribute("DrivingVan",nil)
            telemetry(p,nil)
            if rec.h.Parent then rec.h.PlatformStand=rec.platform;rec.h.AutoRotate=rec.rotate end
            if rec.root.Parent then rec.root.Anchored=rec.anchored;rec.root.AssemblyLinearVelocity=Vector3.zero end
            for part,old in pairs(rec.parts) do if part.Parent then part.Transparency=old.transparency;part.CanCollide=old.collide end end
        end
    end
    local function endRecovery(a)
        local rec=a.recovery;a.recovery=nil
        if rec and rec.h.Parent then rec.h.WalkSpeed=rec.speed;rec.h.PlatformStand=false end
    end
    local function resetTarget(kind)
        local m=world.Targets[kind]
        local index=table.find(C.Vans,defs[kind])
        m:PivotTo(CFrame.new(C.StartX,3.4,C.Lanes[index]))
        m:SetAttribute("RideSpeed",0)
        m.Body.Steal.Enabled=true;active[kind]=nil
        local g=guards[kind];g.mode="return";g.model.Label.Text.Text="BACK TO POST"
    end
    local function clearParking(r)
        if r and r.parkingPad then
            r.parkingPad.Color=r.padColor;r.parkingPad.Material=r.padMaterial
            r.parkingPad:SetAttribute("ParkingState",nil)
        end
    end
    local function abort(p,captured)
        local a=accounts[p];if not a or not a.run then return end
        local kind=a.run.kind;clearParking(a.run);a.run=nil
        release(p,a);resetTarget(kind)
        local r,h=root(p)
        if captured and r then
            endRecovery(a)
            local rec={h=h,speed=h.WalkSpeed,char=p.Character,ready=false,expires=os.clock()+7}
            a.recovery=rec
            r.CFrame=CFrame.new(-92,5,C.Lanes[table.find(C.Vans,defs[kind])]);h.PlatformStand=true
            r.AssemblyLinearVelocity=Vector3.new(10,18,0)
            notice(a,"CAUGHT! Your collection is safe. Up you get!")
            task.delay(.8,function()
                if a.recovery~=rec or p.Character~=rec.char or not h.Parent then return end
                h.PlatformStand=false;h.WalkSpeed=30;rec.ready=true;rec.expires=os.clock()+6
                notice(a,"Sprint back or try another van! Starting a theft ends the boost.");send(p)
                task.delay(6,function()if a.recovery==rec then endRecovery(a);send(p) end end)
            end)
        else notice(a,"Attempt ended. Your secured vans are safe.") end
        send(p)
    end
    local function chooseSlot(a,kind)
        local used={}
        for _,v in pairs(a.vans) do if v.slot&gt;0 then used[v.slot]=true end end
        for i=1,a.capacity do if not used[i] then return i end end
        return 0
    end
    local function park(a,v)
        local pad=v.slot==0 and a.garage.Arrival or a.garage["Slot"..v.slot]
        v.model:PivotTo(CFrame.new(pad.Position.X,3.4,pad.Position.Z))
        v.model:SetAttribute("EarningSlot",v.slot)
    end
    local function secure(p)
        local a=accounts[p];local r=a and a.run
        if not r or not r.parkingReady or not r.parkingPad then return end
        local valid=Parking.Check(r.pos,r.yaw,r.speed,r.parkingPad.Position,r.parkingPad.Size)
        if not valid or chooseSlot(a,r.kind)~=r.parkingSlot then return end
        local kind=r.kind;local def=defs[kind]
        local exitPosition=Vector3.new(r.parkingPad.Position.X-8,5,r.parkingPad.Position.Z)
        clearParking(r);a.run=nil;release(p,a)
        local id=Http:GenerateGUID(false)
        local m=W.Van(a.garage,def,CFrame.new(0,0,0),"Owned_"..id)
        m:SetAttribute("Owner",p.UserId)
        for _,part in ipairs(m:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide=false end end
        local v={kind=kind,model=m,slot=chooseSlot(a,kind)};a.vans[id]=v;park(a,v)
        if v.slot==0 then a.arrival=id end
        a.discovered[kind]=true -- Automatic after correctly parking and exiting; no discovery claim button.
        resetTarget(kind)
        local r=root(p)
        if r then r.CFrame=CFrame.new(exitPosition);r.AssemblyLinearVelocity=Vector3.zero;ReturnSprint.Arm(p,a,exitPosition) end
        local n=0;for _ in pairs(a.discovered) do n+=1 end
        notice(a,v.slot==0 and "Secured! Arrival bay full: visit your trader." or ("Secured! Discovery "..n.."/3. Your van now earns $"..def.income.."/s."))
        if n==3 then notice(a,"3/3 TEST COLLECTION COMPLETE! Keep earning, sell duplicates, or upgrade.") end
        dirty(a);send(p)
    end
    local function steal(p,kind)
        local a=accounts[p];local def=defs[kind];local r,h=root(p)
        if not a or a.closing or not def or not r or a.run then return end
        if a.arrival then notice(a,"Clear your arrival bay at the trader first.");send(p);return end
        if active[kind] then notice(a,"Another player is stealing that van. Pick another.");send(p);return end
        if a.recovery and not a.recovery.ready then return end
        local m=world.Targets[kind]
        if (r.Position-m.Body.Position).Magnitude&gt;17 then return end
        ReturnSprint.Clear(p,a,true)
        endRecovery(a)
        local rec={root=r,h=h,anchored=r.Anchored,platform=h.PlatformStand,rotate=h.AutoRotate,parts={}}
        for _,v in ipairs(p.Character:GetDescendants()) do if v:IsA("BasePart") then rec.parts[v]={transparency=v.Transparency,collide=v.CanCollide};v.Transparency=1;v.CanCollide=false end end
        a.rider=rec;r.Anchored=true;h.PlatformStand=true;h.AutoRotate=false
        local run={kind=kind,pos=m.Body.Position,yaw=0,speed=0,throttle=0,steer=0,time=0,lastInput=os.clock(),definition={speed=def.speed,accel=def.accel},steering=0,wheel=0}
        a.run=run;active[kind]=p;m.Body.Steal.Enabled=false
        p:SetAttribute("DrivingVan",kind)
        telemetry(p,run,a)
        local g=guards[kind];g.model:PivotTo(g.home);g.mode="alert";g.time=0;g.model.Label.Text.Text="HEY! MY VAN!"
        notice(a,"STOLEN! Hold forward and drive to the green line!");send(p)
    end
    local function near(p,position,distance)
        local r=root(p);return r and (r.Position-position).Magnitude&lt;=distance
    end
    local function addPlayer(p)
        if closing then return end
        local index
        for i=1,C.MaxPlayers do if not garageOwners[i] then index=i;break end end
        if not index then p:Kick("All prototype garages are occupied. Please try another server.");return end
        garageOwners[index]=p
        local garage=world.Garages[tostring(index)]
        garage.Label.Text.Text=p.DisplayName.."'s GARAGE"
        local a={cash=0,bank=0,tier=1,capacity=3,accel=0,vans={},discovered={},garage=garage,index=index,status="Pick a van. Approach freely; guards react only when you steal."}
        p:SetAttribute("SaveState","Loading progress...")
        loading+=1
        local saved,error=profiles:Load(tostring(p.UserId))
        loading-=1
        if not saved then
            garageOwners[index]=nil;garage.Label.Text.Text="WAITING FOR PLAYER"
            warn("Ride load failed for "..p.UserId..": "..tostring(error))
            if p.Parent then p:Kick("Your progress could not load safely. Please wait a moment and rejoin. No saved progress was replaced.") end
            return
        end
        a.cash=saved.cash;a.bank=saved.bank;a.tier=saved.tier;a.capacity=saved.capacity;a.accel=saved.accel;a.discovered=saved.discovered
        a.lastSave=os.clock();a.dirty=false
        if not p.Parent or closing then
            profiles:Save(tostring(p.UserId),saved,true)
            garageOwners[index]=nil;garage.Label.Text.Text="WAITING FOR PLAYER"
            return
        end
        Plots.Refresh(a,p.DisplayName.."'s GARAGE");garage=a.garage
        for _,record in ipairs(saved.vans) do
            local model=W.Van(garage,defs[record.kind],CFrame.new(),"Owned_"..record.id)
            model:SetAttribute("Owner",p.UserId)
            for _,part in ipairs(model:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide=false end end
            local v={kind=record.kind,slot=record.slot,model=model}
            a.vans[record.id]=v;park(a,v)
            if record.slot==0 then a.arrival=record.id end
        end
        accounts[p]=a
        p:SetAttribute("SaveState","Progress loaded")
        if a.arrival then notice(a,"Welcome back! Clear your saved arrival bay at the trader.") end
        p.RespawnLocation=world.PrototypeSpawn
        p.CharacterRemoving:Connect(function() ReturnSprint.Clear(p,a,true);abort(p,false);endRecovery(a) end)
        p.CharacterAdded:Connect(function(char)
            local r=char:WaitForChild("HumanoidRootPart",10)
            if r then r.CFrame=CFrame.new(-92,5,0) end
            send(p)
        end)
        local r=root(p);if r then r.CFrame=CFrame.new(-92,5,0) end
        send(p)
    end
    Prompts.PromptTriggered:Connect(function(prompt,p)
        local a=accounts[p];if not a or a.closing then return end
        if prompt.Name=="Steal" and prompt.Parent.Parent.Parent==world.Targets then steal(p,prompt.Parent.Parent.Name)
        elseif prompt==a.garage.Collect.Collect and near(p,a.garage.Collect.Position,16) then
            local n=math.floor(a.bank);a.bank-=n;a.cash+=n;if n&gt;0 then p:SetAttribute("CollectedGarageCash",true) end;dirty(a);notice(a,"Collected $"..n..". Your vans stay parked.");send(p)
        elseif prompt==a.garage.Trader.Torso.Trade and near(p,a.garage.Trader.Torso.Position,16) then send(p);update:FireClient(p,{openTrader=true}) end
    end)
    action.OnServerEvent:Connect(function(p,verb,value,second,brake)
        local a=accounts[p];if not a or a.closing then return end
        if verb=="drive" then
            if not a.run or typeof(value)~="number" or typeof(second)~="number" or value~=value or second~=second or math.abs(value)==math.huge or math.abs(second)==math.huge then return end
            a.run.throttle=math.clamp(value,-1,1);a.run.steer=math.clamp(second,-1,1);a.run.handbrake=brake==true;a.run.lastInput=os.clock();return
        end
        if verb=="exit" then
            if a.run and a.run.parkingReady then secure(p)
            elseif a.run then notice(a,"Park in your marked bay and wait for green before exiting.");send(p) end
            return
        end
        if a.lastAction and os.clock()-a.lastAction&lt;.15 then return end
        a.lastAction=os.clock()
        if verb=="snapshot" then send(p);return end
        if verb=="cancel" then a.quote=nil;send(p);return end
        if not near(p,a.garage.Trader.Torso.Position,20) then notice(a,"Move closer to your trader.");send(p);return end
        if verb=="quote" and typeof(value)=="string" and a.vans[value] then
            local v=a.vans[value]
            a.quote={id=value,token=Http:GenerateGUID(false),expires=os.clock()+20,kind=v.kind,price=defs[v.kind].sale,loss=v.slot&gt;0 and defs[v.kind].income or 0}
        elseif verb=="sell" and typeof(value)=="string" then
            local q=a.quote
            if not q or q.token~=value or os.clock()&gt;q.expires then return end
            a.quote=nil;local v=a.vans[q.id];if not v then return end
            a.vans[q.id]=nil;a.cash+=defs[v.kind].sale;v.model:Destroy()
            if a.arrival==q.id then a.arrival=nil end
            local pending=a.arrival and a.vans[a.arrival]
            if pending then local slot=chooseSlot(a,pending.kind);if slot&gt;0 then pending.slot=slot;a.arrival=nil;park(a,pending) end end
            notice(a,"Sold! Discovery stays in your collection.")
        elseif verb=="upgrade" and value=="accel" then
            if a.accel==0 and a.cash&gt;=C.AccelerationCost then a.cash-=C.AccelerationCost;a.accel=1;notice(a,"Acceleration upgraded by 30%!") else notice(a,"Acceleration already owned or not enough cash.") end
        elseif verb=="upgrade" and (value=="slot" or value=="tier") then
            local ok,message=Tiers.Buy(a,value)
            notice(a,message)
            if ok then
                local pending=a.arrival and a.vans[a.arrival]
                if pending then local slot=chooseSlot(a,pending.kind);if slot&gt;0 then pending.slot=slot;a.arrival=nil end end
                Plots.Refresh(a,p.DisplayName.."'s GARAGE")
                for _,v in pairs(a.vans) do park(a,v) end
            end
        end
        dirty(a);send(p)
    end)
    local elapsed=0
    Run.Heartbeat:Connect(function(dt)
        local step=math.min(dt,.1);elapsed+=dt
        for p,a in pairs(accounts) do
            if a.closing then ReturnSprint.Clear(p,a,true);continue end
            local walkRoot,walkHum=root(p)
            ReturnSprint.Step(p,a,walkRoot,walkHum,C.SafeX,world.SafeLine.Size.Z/2,C.ReturnSprintSpeed)
            a.bank+=income(a)*dt
            local r=a.run
            if r then
                local hrp=root(p)
                if not hrp then abort(p,false) else
                    local d=defs[r.kind];r.time+=step
                    if os.clock()-r.lastInput&gt;.5 then r.throttle=0;r.steer=0;r.handbrake=false end
                    Driving.Step(r,d,step,a.accel)
                    local target=world.Targets[r.kind]
                    target:PivotTo(Driving.Frame(r))
                    target:SetAttribute("RideSpeed",r.speed)
                    r.motionTime=(r.motionTime or 0)+step
                    if r.motionTime&gt;=.06 then r.motionTime=0;telemetry(p,r,a) end
                    hrp.CFrame=CFrame.new(r.pos+Vector3.new(2,2,0))
                    local guard=guards[r.kind]
                    if not r.escaped and r.pos.X&gt;=C.SafeX then
                        r.escaped=true;r.parkingSlot=chooseSlot(a,r.kind)
                        r.parkingPad=r.parkingSlot==0 and a.garage.Arrival or a.garage["Slot"..r.parkingSlot]
                        r.padColor=r.parkingPad.Color;r.padMaterial=r.parkingPad.Material
                        guard.mode="return";guard.model.Label.Text.Text="BACK TO POST"
                        notice(a,"SAFE! Drive to your amber parking bay. Stop fully inside, then exit when green.")
                    end
                    if r.escaped then
                        local valid,message=Parking.Check(r.pos,r.yaw,r.speed,r.parkingPad.Position,r.parkingPad.Size)
                        r.parkTime=valid and ((r.parkTime or 0)+step) or 0
                        r.parkingReady=r.parkTime&gt;=Parking.HoldTime
                        r.parkingPad.Color=r.parkingReady and Color3.fromRGB(62,235,130) or Color3.fromRGB(255,183,58)
                        r.parkingPad.Material=Enum.Material.Neon
                        r.parkingPad:SetAttribute("ParkingState",r.parkingReady and "Ready" or "Align")
                        local wanted=r.parkingReady and "PARKED! Green bay - press E or Exit van to get out."
                            or ("Garage "..a.garage.Name.." / "..(r.parkingSlot==0 and "Arrival bay" or "Slot "..r.parkingSlot)..": "..message)
                        notice(a,wanted)
                    elseif r.time&gt;=d.reaction then
                        guard.mode="chase";guard.model.Label.Text.Text="STOP THAT VAN!"
                        local pos=guard.model.PrimaryPart.Position
                        local deltaPos=Vector3.new(r.pos.X,pos.Y,r.pos.Z)-pos
                        if deltaPos.Magnitude&gt;0.1 then
                            local nextPos=pos+deltaPos.Unit*math.min(deltaPos.Magnitude,d.guardSpeed*step)
                            guard.model:PivotTo(CFrame.lookAt(nextPos,Vector3.new(r.pos.X,nextPos.Y,r.pos.Z)))
                        end
                        if deltaPos.Magnitude&lt;4.5 and not a.recovery then abort(p,true) end
                    end
                end
            end
        end
        for _,g in pairs(guards) do
            if g.mode=="return" then
                local pos=g.model:GetPivot().Position;local delta=g.home.Position-pos
                if delta.Magnitude&lt;.4 then g.model:PivotTo(g.home);g.mode="idle";g.model.Label.Text.Text="SECURITY"
                else g.model:PivotTo(CFrame.lookAt(pos+delta.Unit*math.min(delta.Magnitude,18*step),g.home.Position)) end
            end
        end
        if elapsed&gt;=.4 then elapsed=0;for p in pairs(accounts) do send(p) end end
    end)
    Players.PlayerAdded:Connect(function(p)task.spawn(addPlayer,p)end)
    for _,p in ipairs(Players:GetPlayers()) do task.spawn(addPlayer,p) end
    task.spawn(function()
        while not closing do
            task.wait(5)
            for p,a in pairs(accounts) do
                if not a.closing and not a.saving and (os.clock()-a.lastSave&gt;=ProfileStore.AutosaveSeconds or a.dirty and os.clock()-a.lastSave&gt;=10) then
                    a.saving=true
                    task.spawn(function()save(p,a,false);a.saving=false end)
                end
            end
        end
    end)
    Players.PlayerRemoving:Connect(function(p)
        local a=accounts[p];if not a then return end
        a.closing=true
        ReturnSprint.Clear(p,a,true)
        abort(p,false);endRecovery(a)
        while a.saving do task.wait(.05) end
        save(p,a,true)
        for _,v in pairs(a.vans) do v.model:Destroy() end
        a.garage.Label.Text.Text="WAITING FOR PLAYER";garageOwners[a.index]=nil;accounts[p]=nil
    end)

    game:BindToClose(function()
        closing=true
        for p,a in pairs(accounts) do
            if not a.closing then
                a.closing=true
                task.spawn(function()
                    while a.saving do task.wait(.05) end
                    save(p,a,true)
                end)
            end
        end
        local deadline=os.clock()+25
        task.wait(.1)
        while os.clock()&lt;deadline do
            local pending=loading&gt;0 or savesInFlight&gt;0
            for _,a in pairs(accounts) do if not a.released then pending=true end end
            if not pending then break end
            task.wait(.1)
        end
    end)

    -- Server-only inspection interface for local acceptance tests. No debug remote.
    function G.Inspect(p)
        local a=accounts[p];if not a then return nil end
        local n=0;for _ in pairs(a.discovered) do n+=1 end
        local v={};for id,item in pairs(a.vans) do table.insert(v,{id=id,kind=item.kind,slot=item.slot}) end
        return {cash=a.cash,bank=a.bank,rate=income(a),discoveries=n,vans=v,arrival=a.arrival,status=a.status,driving=a.run~=nil,capacity=a.capacity,tier=a.tier,accel=a.accel}
    end
end
return G
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12553">
        <Properties>
          <string name="Name">Scenery</string>
          <ProtectedString name="Source">local S={}
function S.Apply(world)
 local base=workspace:FindFirstChild("Baseplate")
 if base and base:IsA("BasePart") then
  base.Color=Color3.fromRGB(108,151,91);base.Material=Enum.Material.Grass
  for _,v in ipairs(base:GetChildren()) do if v:IsA("Texture") or v:IsA("Decal") then v.Transparency=1 end end
 end
 local oldSpawn=workspace:FindFirstChild("SpawnLocation")
 if oldSpawn and oldSpawn:IsA("SpawnLocation") then
  oldSpawn.Enabled=false;oldSpawn.Transparency=1;oldSpawn.CanCollide=false
  for _,v in ipairs(oldSpawn:GetChildren()) do if v:IsA("Decal") then v.Transparency=1 end end
 end
 if world:FindFirstChild("Scenery") then return end
 local folder=Instance.new("Folder");folder.Name="Scenery"
 local palette={stone=Color3.fromRGB(201,205,184),dark=Color3.fromRGB(39,65,71),grass=Color3.fromRGB(108,151,91),teal=Color3.fromRGB(58,156,147),gold=Color3.fromRGB(238,190,78)}
 local count=0
 local function block(name,size,pos,color,material,collide)
  local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=typeof(pos)=="CFrame" and pos or CFrame.new(pos)
  p.Anchored=true;p.CanCollide=collide==true;p.CanTouch=false;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
  p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=folder;count+=1;return p
 end
 local function surface(p,face,text,color)
  local gui=Instance.new("SurfaceGui");gui.Face=face;gui.CanvasSize=Vector2.new(900,180);gui.Parent=p
  local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text=text
  label.Font=Enum.Font.GothamBold;label.TextScaled=true;label.TextColor3=color;label.Parent=gui
  local pad=Instance.new("UIPadding");pad.PaddingTop=UDim.new(0,20);pad.PaddingBottom=UDim.new(0,20);pad.PaddingLeft=UDim.new(0,20);pad.PaddingRight=UDim.new(0,20);pad.Parent=label
 end
 block("Island",Vector3.new(290,5,220),Vector3.new(-5,-2.6,0),palette.grass,Enum.Material.Grass,true)
 block("DepotApron",Vector3.new(64,.15,196),Vector3.new(99,.42,0),Color3.fromRGB(90,111,108),Enum.Material.Concrete,true)
 for _,z in ipairs({-58,58}) do
  block("Sidewalk",Vector3.new(208,.3,6),Vector3.new(-36,.55,z),palette.stone,Enum.Material.Concrete,true)
  for x=-130,60,10 do block("PavingSeam",Vector3.new(.08,.03,5.8),Vector3.new(x,.72,z),Color3.fromRGB(160,174,155)) end
 end
 -- Solid perimeter walls and tall panels contain walking players.
 for _,z in ipairs({-108,108}) do
  block("BorderWall",Vector3.new(286,4,2),Vector3.new(-5,2,z),palette.stone,Enum.Material.Concrete,true)
  block("BorderCap",Vector3.new(288,.5,2.6),Vector3.new(-5,4.2,z),palette.dark,nil,true)
  block("Fence",Vector3.new(284,7,.45),Vector3.new(-5,7.7,z),palette.dark,Enum.Material.Metal,true)
  for x=-147,137,12 do block("FencePost",Vector3.new(.7,11,.7),Vector3.new(x,5.5,z),palette.teal,nil,true) end
 end
 for _,x in ipairs({-148,138}) do
  block("BorderWall",Vector3.new(2,4,218),Vector3.new(x,2,0),palette.stone,Enum.Material.Concrete,true)
  block("BorderCap",Vector3.new(2.6,.5,220),Vector3.new(x,4.2,0),palette.dark,nil,true)
  block("Fence",Vector3.new(.45,7,216),Vector3.new(x,7.7,0),palette.dark,Enum.Material.Metal,true)
  for z=-108,108,12 do block("FencePost",Vector3.new(.7,11,.7),Vector3.new(x,5.5,z),palette.teal,nil,true) end
 end
 folder.Parent=world;task.wait()
 local function tree(x,z,scale)
  local trunk=block("TreeTrunk",Vector3.new(1.4,7,1.4)*scale,Vector3.new(x,3.5*scale,z),Color3.fromRGB(107,85,61),Enum.Material.Wood)
  local leaf=block("TreeCrown",Vector3.new(9,10,9)*scale,Vector3.new(x,10*scale,z),Color3.fromRGB(53,119,81),Enum.Material.Grass);leaf.Shape=Enum.PartType.Ball
  local top=block("TreeCrownLight",Vector3.new(6,7,6)*scale,Vector3.new(x-1,14*scale,z),Color3.fromRGB(84,150,90),Enum.Material.Grass);top.Shape=Enum.PartType.Ball
  block("TreePlanter",Vector3.new(9,.5,9)*scale,Vector3.new(x,.15,z),Color3.fromRGB(87,124,74),Enum.Material.Grass)
 end
 for _,z in ipairs({-81,81}) do for x=-125,45,34 do tree(x,z,1+((x+125)%3)*.1) end end
 local function lamp(x,z)
  block("LampBase",Vector3.new(2,.6,2),Vector3.new(x,.8,z),palette.stone)
  block("LampPost",Vector3.new(.5,14,.5),Vector3.new(x,7.5,z),palette.dark,Enum.Material.Metal)
  block("LampArm",Vector3.new(4,.4,.4),Vector3.new(x+1.6,14,z),palette.dark,Enum.Material.Metal)
  local light=block("Lamp",Vector3.new(3,.3,1.5),Vector3.new(x+2.5,13.7,z),Color3.fromRGB(255,237,190),Enum.Material.Neon)
  local glow=Instance.new("PointLight");glow.Brightness=.7;glow.Range=18;glow.Color=light.Color;glow.Parent=light
 end
 for _,z in ipairs({-62,62}) do for x=-115,55,42 do lamp(x,z) end end
 -- Ornamental distant hills frame the map without occupying gameplay routes.
 for i=1,9 do
  local x=-180+(i-1)*44
  for _,z in ipairs({-145,145}) do
   local hill=block("BackdropHill",Vector3.new(65,32+(i%3)*13,50),Vector3.new(x,3,z),Color3.fromRGB(96+i*3,139+i*2,96),Enum.Material.Grass)
   hill.Shape=Enum.PartType.Ball
  end
 end
 task.wait()
 local accents={palette.teal,Color3.fromRGB(87,140,185),palette.gold,Color3.fromRGB(192,111,85)}
 for _,garage in ipairs(world.Garages:GetChildren()) do
  local z=garage.Floor.Position.Z;local accent=accents[tonumber(garage.Name)] or palette.teal
  garage.Floor.Color=Color3.fromRGB(109,127,122);garage.Floor.Material=Enum.Material.Concrete
  garage.BackWall.Color=palette.dark
  block("GarageCornice",Vector3.new(2,1,43),Vector3.new(124,10.5,z),accent)
  block("GarageCanopy",Vector3.new(10,.7,43),Vector3.new(120,17,z),palette.dark)
  for _,side in ipairs({-20,20}) do
   block("GaragePillar",Vector3.new(1.3,17,1.3),Vector3.new(116,8.5,z+side),accent)
   block("GarageSideTrim",Vector3.new(48,.18,.45),Vector3.new(100,.66,z+side),accent)
  end
  local sign=block("GarageNumber",Vector3.new(.3,3,12),Vector3.new(122.9,13,z),accent)
  surface(sign,Enum.NormalId.Left,"GARAGE 0"..garage.Name,Color3.fromRGB(247,244,225))
  for slot=1,3 do
   local pad=garage["Slot"..slot]
   for _,side in ipairs({-1,1}) do
    block("ParkingStripe",Vector3.new(17,.06,.18),pad.Position+Vector3.new(0,.11,5.5*side),Color3.fromRGB(235,233,210))
   end
   local num=block("SlotNumber",Vector3.new(2,.04,2),pad.Position+Vector3.new(-4,.13,0),palette.dark)
   surface(num,Enum.NormalId.Top,tostring(slot),Color3.fromRGB(245,233,183))
  end
  local a=garage.Arrival
  for n=-7,7,2 do block("ArrivalStripe",Vector3.new(.7,.04,10.6),a.CFrame*CFrame.new(n,.12,0),palette.gold) end
  local till=garage.Collect
  local display=block("CashDisplay",Vector3.new(2.6,2.1,.3),CFrame.new(till.Position+Vector3.new(0,1.6,0)),palette.dark)
  surface(display,Enum.NormalId.Front,"CASH",Color3.fromRGB(116,255,181))
  block("TraderAwning",Vector3.new(7,.5,5),garage.Trader.Torso.Position+Vector3.new(0,4,0),accent)
 end
 -- Welcome arch is above the chase camera and outside the van start positions.
 for _,z in ipairs({-51,51}) do block("DepotArchPillar",Vector3.new(2,20,2),Vector3.new(-137,10,z),palette.dark,nil,true) end
 local header=block("DepotHeader",Vector3.new(2,5,104),Vector3.new(-137,21,0),palette.teal)
 surface(header,Enum.NormalId.Right,"STEAL A RIDE  /  VEHICLE DEPOT",Color3.fromRGB(255,241,198))
 for _,z in ipairs({-51,51}) do
  block("SafeGatePillar",Vector3.new(1.3,17,1.3),Vector3.new(65,8.5,z),palette.dark)
  block("SafeGateLight",Vector3.new(1.5,3,1.5),Vector3.new(65,16,z),Color3.fromRGB(115,255,187),Enum.Material.Neon)
 end
 local lighting=game:GetService("Lighting")
 lighting.ClockTime=15.2;lighting.Brightness=2.5
 lighting.Ambient=Color3.fromRGB(110,119,128);lighting.OutdoorAmbient=Color3.fromRGB(137,150,156)
 lighting.EnvironmentDiffuseScale=.65;lighting.EnvironmentSpecularScale=.35;lighting.ShadowSoftness=.35
 local grade=lighting:FindFirstChild("RideColorGrade") or Instance.new("ColorCorrectionEffect")
 grade.Name="RideColorGrade";grade.Saturation=.09;grade.Contrast=.06;grade.TintColor=Color3.fromRGB(255,249,235);grade.Parent=lighting
 local bloom=lighting:FindFirstChild("RideBloom") or Instance.new("BloomEffect")
 bloom.Name="RideBloom";bloom.Intensity=.12;bloom.Size=20;bloom.Threshold=1.5;bloom.Parent=lighting
 local base=workspace:FindFirstChild("Baseplate")
 if base and base:IsA("BasePart") then base.Color=palette.grass;base.Material=Enum.Material.Grass end
 folder:SetAttribute("Version",1);folder:SetAttribute("Parts",count)
 return count
end
return S
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12557">
        <Properties>
          <string name="Name">ProfileStore</string>
          <ProtectedString name="Source">-- One atomic record per player, with expiring ownership and serialized writes.
local ProfileStore={}
local Tiers=require(script.Parent.GarageTiers)
ProfileStore.Schema=2
ProfileStore.LeaseSeconds=180
ProfileStore.AutosaveSeconds=45
local function copy(v)
 if type(v)~="table" then return v end
 local r={};for k,x in pairs(v) do r[k]=copy(x) end;return r
end
local function number(v,min,max)
 return type(v)=="number" and v==v and v&gt;=min and v&lt;=max
end
function ProfileStore.Validate(data,allowed)
 if type(data)~="table" or (data.schema~=1 and data.schema~=2) then return nil,"Unsupported save format" end
 local legacy=data.schema==1
 if legacy then
  if data.capacity~=2 and data.capacity~=3 then return nil,"Invalid legacy capacity" end
  local paidThird=data.capacity==3
  data=copy(data);data.schema=2;data.tier=1;data.capacity=3
  if paidThird and number(data.cash,0,1e12-180) then data.cash+=180 end
 end
 local tier=Tiers.List[data.tier]
 if not tier then return nil,"Invalid garage tier" end
 if not number(data.cash,0,1e12) or data.cash%1~=0 or not number(data.bank,0,1e12) then return nil,"Invalid balances" end
 if not number(data.capacity,tier.included,tier.max) or data.capacity%1~=0 then return nil,"Invalid capacity" end
 if data.accel~=0 and data.accel~=1 then return nil,"Invalid upgrade" end
 if type(data.vans)~="table" or type(data.discovered)~="table" then return nil,"Invalid collection" end
 local used,ids={},{};local arrival,count=0,0
 for key,v in pairs(data.vans) do
  count+=1
  if type(key)~="number" or key%1~=0 or key&lt;1 or key&gt;data.capacity+1 or count&gt;data.capacity+1 then return nil,"Invalid van list" end
  if type(v)~="table" or type(v.id)~="string" or #v.id&gt;80 or #v.id==0 or ids[v.id] or not allowed[v.kind] then return nil,"Invalid van" end
  if not number(v.slot,0,data.capacity) or v.slot%1~=0 then return nil,"Invalid slot" end
  ids[v.id]=true
  if v.slot==0 then arrival+=1;if arrival&gt;1 then return nil,"Multiple arrivals" end
  else if used[v.slot] then return nil,"Duplicate earning slot" end;used[v.slot]=true end
  if data.discovered[v.kind]~=true then return nil,"Owned van missing discovery" end
 end
 if count~=#data.vans then return nil,"Sparse van list" end
 for kind,value in pairs(data.discovered) do if not allowed[kind] or value~=true then return nil,"Invalid discovery" end end
 return copy(data)
end
function ProfileStore.Default()
 return {schema=2,tier=1,cash=0,bank=0,capacity=3,accel=0,vans={},discovered={}}
end
function ProfileStore.new(store,token,allowed,clock,waiter)
 local self={store=store,token=token,allowed=allowed,clock=clock or os.time,wait=waiter or task.wait,sessions={}}
 local function update(key,fn)
  local err
  for attempt=1,3 do
   local ok,result=pcall(function()return store:UpdateAsync(key,fn)end)
   if ok then return true,result end
   err=tostring(result);if attempt&lt;3 then self.wait(attempt) end
  end
  return false,err
 end
 function self:Load(key)
  if self.sessions[key] then return nil,"Already loaded" end
  local denied
  local ok,record=update(key,function(old)
   denied=nil
   if old~=nil and (type(old)~="table" or old.format~=1 or type(old.data)~="table") then denied="Unknown record format";return nil end
   if old and old.lock and old.lock.owner~=self.token and old.lock.untilTime&gt;self.clock() then denied="Progress is still open in another server";return nil end
   local data,error=ProfileStore.Validate(old and old.data or ProfileStore.Default(),allowed)
   if not data then denied=error;return nil end
   return {format=1,data=data,revision=old and old.revision or 0,lock={owner=self.token,untilTime=self.clock()+ProfileStore.LeaseSeconds}}
  end)
  if not ok then return nil,"Load request failed: "..tostring(record) end
  if denied or not record then return nil,denied or "Load canceled" end
  if not record.lock or record.lock.owner~=self.token then return nil,"Session ownership unavailable" end
  self.sessions[key]={busy=false,closed=false,expires=record.lock.untilTime}
  return copy(record.data)
 end
 function self:Save(key,data,release)
  local session=self.sessions[key]
  if not session or session.closed then return false,"No writable session" end
  local valid,error=ProfileStore.Validate(data,allowed)
  if not valid then return false,error end
  while session.busy do self.wait(.05) end
  if session.closed then return false,"Session closed" end
  session.busy=true
  local denied
  local ok,record=update(key,function(old)
   denied=nil
   if not old or not old.lock or old.lock.owner~=self.token then denied="Session ownership lost";return nil end
   local revision=(old.revision or 0)+1
   return {format=1,data=copy(valid),revision=revision,savedAt=self.clock(),lock=not release and {owner=self.token,untilTime=self.clock()+ProfileStore.LeaseSeconds} or nil}
  end)
  session.busy=false
  if denied then session.closed=true;return false,denied end
  if not ok or not record then return false,"Save request failed: "..tostring(record) end
  session.expires=release and 0 or record.lock.untilTime
  if release then session.closed=true end
  return true
 end
 function self:Owns(key)
  local s=self.sessions[key];return s and not s.closed and self.clock()&lt;s.expires
 end
 return self
end
return ProfileStore
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12561">
        <Properties>
          <string name="Name">ReturnSprint</string>
          <ProtectedString name="Source">local Sprint={}
function Sprint.Clear(player,state,consume)
 local boost=state.returnBoost
 state.returnBoost=nil
 if boost and boost.humanoid.Parent then
  -- Do not overwrite a speed that another movement system changed.
  if boost.humanoid.WalkSpeed==boost.applied then boost.humanoid.WalkSpeed=boost.previous end
 end
 player:SetAttribute("ReturnSprintActive",nil)
 if consume then state.returnSprintArmed=nil;state.returnPreviousX=nil end
end
function Sprint.Arm(player,state,position)
 Sprint.Clear(player,state,true)
 state.returnSprintArmed=true
 state.returnPreviousX=position.X
end
function Sprint.Step(player,state,root,humanoid,lineX,lineHalfWidth,sprintSpeed)
 if not root or not humanoid or humanoid.Health&lt;=0 then Sprint.Clear(player,state,true);return end
 if state.run or state.closing then Sprint.Clear(player,state,true);return end
 local x=root.Position.X
 if state.recovery then
  Sprint.Clear(player,state,false)
  state.returnPreviousX=x
  return
 end
 if state.returnBoost and state.returnBoost.humanoid~=humanoid then
  Sprint.Clear(player,state,true);return
 end
 if x&gt;=lineX+.5 or math.abs(root.Position.Z)&gt;lineHalfWidth then
  Sprint.Clear(player,state,false)
 end
 local crossed=state.returnPreviousX and state.returnPreviousX&gt;=lineX and x&lt;lineX
 if state.returnSprintArmed and not state.returnBoost and crossed and math.abs(root.Position.Z)&lt;=lineHalfWidth then
  local applied=math.max(humanoid.WalkSpeed,sprintSpeed)
  state.returnBoost={humanoid=humanoid,previous=humanoid.WalkSpeed,applied=applied}
  humanoid.WalkSpeed=applied
  player:SetAttribute("ReturnSprintActive",true)
 end
 state.returnPreviousX=x
end
return Sprint
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12565">
        <Properties>
          <string name="Name">GarageTiers</string>
          <ProtectedString name="Source">local T={}
T.List={
 {name="Starter",included=3,max=6,price=0,slots={400,900,1800},color=Color3.fromRGB(75,159,144),description="Neighborhood garage with timber trim",rows=6,depth=62},
 {name="Workshop",included=8,max=12,price=12000,slots={2400,3200,4000,5000},color=Color3.fromRGB(79,148,198),description="Workshop with metal shutters and overhead lighting",rows=8,depth=110},
 {name="Warehouse",included=14,max=18,price=36000,slots={6500,8000,9500,11000},color=Color3.fromRGB(221,159,61),description="Industrial warehouse with steel beams",rows=8,depth=158},
 {name="Showroom",included=20,max=24,price=75000,slots={14000,16000,18000,20000},color=Color3.fromRGB(159,116,210),description="Glass displays and polished showroom floor",rows=8,depth=174},
 {name="Elite Garage",included=28,max=32,price=130000,slots={24000,28000,32000,36000},color=Color3.fromRGB(230,200,112),description="Luxury collection hall with illuminated displays",rows=8,depth=206},
}
function T.SlotCost(tier,capacity)
 local d=T.List[tier];if not d or capacity&gt;=d.max then return nil end
 return d.slots[capacity-d.included+1]
end
function T.Offer(a)
 local tier=a.tier or 1;local current=T.List[tier];local nextTier=T.List[tier+1]
 return {tier=tier,name=current.name,max=current.max,slotCost=T.SlotCost(tier,a.capacity),
 nextTier=nextTier and {tier=tier+1,name=nextTier.name,price=nextTier.price,included=nextTier.included,max=nextTier.max,description=nextTier.description},
 canTier=nextTier~=nil and a.capacity==current.max}
end
function T.Buy(a,kind)
 if a.run then return false,"Park and exit your van before upgrading." end
 if kind=="slot" then
  local cost=T.SlotCost(a.tier,a.capacity)
  if not cost then return false,"All slots in this tier are unlocked." end
  if a.cash&lt;cost then return false,"Not enough cash. Collect your garage earnings first." end
  a.cash-=cost;a.capacity+=1;return true,"Slot "..a.capacity.." unlocked!"
 elseif kind=="tier" then
  local current=T.List[a.tier];local nextTier=T.List[a.tier+1]
  if not nextTier then return false,"Maximum garage tier reached." end
  if a.capacity~=current.max then return false,"Unlock all "..current.max.." slots first. They do not need to be occupied." end
  if a.cash&lt;nextTier.price then return false,"Not enough cash for the next garage." end
  a.cash-=nextTier.price;a.tier+=1;a.capacity=nextTier.included
  return true,nextTier.name.." unlocked with "..a.capacity.." usable slots!"
 end
 return false,"Unknown garage upgrade."
end
return T
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12569">
        <Properties>
          <string name="Name">GaragePlots</string>
          <ProtectedString name="Source">local T=require(script.Parent.GarageTiers)
local M={}
local function part(parent,name,size,pos,color,material,collide)
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.Position=pos;p.Color=color;p.Anchored=true
 p.Material=material or Enum.Material.SmoothPlastic;p.CanCollide=collide==true;p.CanTouch=false
 p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
local function text(parent,adornee,message,offset)
 local b=Instance.new("BillboardGui");b.Name="Label";b.Size=UDim2.fromOffset(300,55);b.StudsOffset=offset or Vector3.new(0,9,0);b.Adornee=adornee;b.MaxDistance=110;b.Parent=parent
 local t=Instance.new("TextLabel");t.Name="Text";t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1;t.Text=message;t.TextSize=18;t.TextColor3=Color3.fromRGB(236,244,233);t.TextStrokeTransparency=.3;t.Font=Enum.Font.GothamBold;t.Parent=b
end
local function prompt(p,name,action,label)
 local v=Instance.new("ProximityPrompt");v.Name=name;v.ActionText=action;v.ObjectText=label;v.MaxActivationDistance=13;v.RequiresLineOfSight=false;v.Parent=p
end
function M.Build(index,tier,capacity,owner)
 local d=T.List[tier];local z=(index-2.5)*152
 local m=Instance.new("Model");m.Name=tostring(index);m:SetAttribute("Tier",tier);m:SetAttribute("Capacity",capacity)
 local width=d.rows*14+12
 local floor=part(m,"Floor",Vector3.new(d.depth,1,width),Vector3.new(76+d.depth/2,0,z),Color3.fromRGB(87,107,111),tier&gt;=4 and Enum.Material.Marble or Enum.Material.Concrete,true);m.PrimaryPart=floor
 local entrance=part(m,"Entrance",Vector3.new(2,.15,14),Vector3.new(77,.6,z),d.color,Enum.Material.Neon)
 text(m,floor,owner or "WAITING FOR PLAYER",Vector3.new(-d.depth/2+8,15,0))
 local decor=Instance.new("Folder");decor.Name="Architecture";decor.Parent=m
 part(decor,"BackWall",Vector3.new(1,16,width),Vector3.new(76+d.depth,8,z),Color3.fromRGB(31,47,60),nil,true)
 for _,side in ipairs({-1,1}) do
  part(decor,"SideTrim",Vector3.new(d.depth,.2,1),Vector3.new(76+d.depth/2,.7,z+side*width/2),d.color,Enum.Material.Neon)
  part(decor,"SideWall",Vector3.new(d.depth,5,1),Vector3.new(76+d.depth/2,2.5,z+side*width/2),Color3.fromRGB(43,63,74),nil,true)
  for x=80,76+d.depth,24 do part(decor,"Pillar",Vector3.new(1,18,1),Vector3.new(x,9,z+side*width/2),d.color,Enum.Material.Metal) end
 end
 local header=part(decor,"TierSign",Vector3.new(2,4,width),Vector3.new(78,18,z),d.color)
 text(decor,header,"TIER "..tier.."  •  "..d.name:upper(),Vector3.new(0,1,0))
 for x=90,76+d.depth-4,36 do
  part(decor,"RoofBeam",Vector3.new(1,1,width),Vector3.new(x,18,z),Color3.fromRGB(42,60,72),Enum.Material.Metal)
  if tier&gt;=2 then
   local light=part(decor,"OverheadLight",Vector3.new(1,.2,10),Vector3.new(x,17.3,z),Color3.fromRGB(255,241,195),Enum.Material.Neon)
   local point=Instance.new("PointLight");point.Range=25;point.Brightness=.5;point.Parent=light
  end
 end
 if tier==1 then
  for _,side in ipairs({-1,1}) do part(decor,"Timber",Vector3.new(1,8,1),Vector3.new(78,4,z+side*width/2),Color3.fromRGB(131,94,67),Enum.Material.Wood) end
 elseif tier==2 then
  for i=1,8 do part(decor,"ShutterSlat",Vector3.new(.2,.4,width-4),Vector3.new(76+d.depth-.6,3+i,z),Color3.fromRGB(115,139,156),Enum.Material.Metal) end
 elseif tier&gt;=4 then
  for _,side in ipairs({-1,1}) do
   local glass=part(decor,"ShowroomGlass",Vector3.new(d.depth-6,8,.2),Vector3.new(76+d.depth/2,9,z+side*width/2),Color3.fromRGB(164,220,224),Enum.Material.Glass);glass.Transparency=.65
  end
 end
 for slot=1,d.max do
  local col=math.floor((slot-1)/d.rows);local row=(slot-1)%d.rows
  local pos=Vector3.new(112+col*48,.65,z+(row-(d.rows-1)/2)*14)
  local pad=part(m,"Slot"..slot,Vector3.new(17,.15,11),pos,slot&lt;=capacity and Color3.fromRGB(89,140,130) or Color3.fromRGB(60,68,75))
  pad:SetAttribute("Slot",slot);pad:SetAttribute("Unlocked",slot&lt;=capacity)
  for _,side in ipairs({-1,1}) do part(decor,"ParkingLine",Vector3.new(17,.05,.15),pos+Vector3.new(0,.12,5.5*side),slot&lt;=capacity and d.color or Color3.fromRGB(112,117,120)) end
  text(decor,pad,slot&lt;=capacity and tostring(slot) or ("LOCKED "..slot),Vector3.new(0,.6,0))
  if tier==5 then part(decor,"DisplayLight",Vector3.new(17,.05,.2),pos+Vector3.new(0,.15,-5),d.color,Enum.Material.Neon) end
 end
 local arrival=part(m,"Arrival",Vector3.new(17,.15,11),Vector3.new(88,.65,z+22),Color3.fromRGB(220,161,54));text(decor,arrival,"ARRIVAL",Vector3.new(0,1,0))
 local cash=part(m,"Collect",Vector3.new(3,1.2,3),Vector3.new(85,1.2,z-22),Color3.fromRGB(64,195,131));prompt(cash,"Collect","Collect","Garage income")
 local trader=Instance.new("Model");trader.Name="Trader";trader.Parent=m
 local torso=part(trader,"Torso",Vector3.new(2,2,1),Vector3.new(86,3,z),d.color);trader.PrimaryPart=torso
 part(trader,"Head",Vector3.new(1.5,1.5,1.5),Vector3.new(86,4.8,z),Color3.fromRGB(221,182,138))
 for _,dx in ipairs({-.55,.55}) do part(trader,"Leg",Vector3.new(.8,2,1),Vector3.new(86+dx,1,z),Color3.fromRGB(34,45,59)) end
 prompt(torso,"Trade","Garage services","Sell / Garage upgrades");text(trader,torso,"GARAGE SERVICES",Vector3.new(0,5,0))
 m:SetAttribute("PlotCenterZ",z)
 return m
end
function M.Apply(world)
 if world:GetAttribute("GarageTierLayout")==true then return end
 local old=world:FindFirstChild("Garages");if old then old:Destroy() end
 local garages=Instance.new("Folder");garages.Name="Garages";garages.Parent=world
 for i=1,4 do local m=M.Build(i,1,3);m.Parent=garages end
 -- Replace only the scenery generated by our previous builder.
 local scenery=world:FindFirstChild("Scenery")
 if scenery then
  local remove={GarageCornice=true,GarageCanopy=true,GaragePillar=true,GarageSideTrim=true,GarageNumber=true,ParkingStripe=true,SlotNumber=true,ArrivalStripe=true,CashDisplay=true,TraderAwning=true,BorderWall=true,BorderCap=true,Fence=true,FencePost=true,DepotApron=true}
  for _,v in ipairs(scenery:GetChildren()) do if remove[v.Name] or v:IsA("BasePart") and v.Name=="BackdropHill" and v.Position.X&gt;65 then v:Destroy() end end
 end
 local env=Instance.new("Folder");env.Name="GarageDistrict";env.Parent=world
 part(env,"Apron",Vector3.new(244,1,600),Vector3.new(186,0,0),Color3.fromRGB(63,78,84),Enum.Material.Asphalt,true)
 for _,z in ipairs({-304,304}) do part(env,"Border",Vector3.new(458,12,2),Vector3.new(80,6,z),Color3.fromRGB(35,67,71),nil,true) end
 for _,x in ipairs({-149,309}) do part(env,"Border",Vector3.new(2,12,610),Vector3.new(x,6,0),Color3.fromRGB(35,67,71),nil,true) end
 for _,z in ipairs({-152,0,152}) do part(env,"PlotGap",Vector3.new(226,.1,22),Vector3.new(194,.55,z),Color3.fromRGB(92,145,98),Enum.Material.Grass) end
 world.SafeLine.Size=Vector3.new(1,.12,600)
 world:SetAttribute("GarageTierLayout",true)
end
function M.Refresh(a,owner)
 local old=a.garage;local fresh=M.Build(a.index,a.tier,a.capacity,owner)
 fresh.Parent=old.Parent
 for _,v in pairs(a.vans) do
  v.model.Parent=fresh
  local pad=v.slot==0 and fresh.Arrival or fresh["Slot"..v.slot]
  v.model:PivotTo(CFrame.new(pad.Position.X,3.4,pad.Position.Z))
 end
 a.garage=fresh;old:Destroy()
end
return M
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="RBX12573">
      <Properties>
        <string name="Name">StartRide</string>
        <ProtectedString name="Source">local preview=workspace:FindFirstChild("RidePreview")
if preview then preview:Destroy() end
require(script.Parent.RidePrototype.Game).Start()
