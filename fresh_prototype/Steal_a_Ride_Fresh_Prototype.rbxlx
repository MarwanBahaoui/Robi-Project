  <Item class="ReplicatedStorage" referent="RBX12577">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBX12580">
      <Properties>
        <string name="Name">RideNetwork</string>
      </Properties>
      <Item class="RemoteEvent" referent="RBX12583">
        <Properties>
          <string name="Name">Action</string>
        </Properties>
      </Item>
      <Item class="RemoteEvent" referent="RBX12586">
        <Properties>
          <string name="Name">Update</string>
